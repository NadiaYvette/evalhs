mkImp :: (Maybe String, String, Maybe String, [String]) -> [String]
mkImp (mPkg, mod, mQual, hides) =
  ["import"] <> maybe [] (\pkg -> ["\"" <> pkg <> "\""]) mPkg
             <> [mod]
             <> maybe [] (\qual -> ["qualified", "as", qual]) mQual
             <> case hides of
                  [] -> []
                  _ : _ -> ["hiding ("] <> List.intersperse "," hides <> [")"]

